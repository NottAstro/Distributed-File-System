# ========================================
# Distributed File System — Environment Variables
# ========================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env  (Windows)
#   cp .env.example .env    (Linux/Mac)
#
# NEVER commit the .env file!
# ========================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=distributed_fs

# --- Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=24h

# --- Google OAuth ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Email (SMTP) ---
# For Gmail: use smtp.gmail.com + App Password (https://myaccount.google.com/apppasswords)
# For SendGrid: use smtp.sendgrid.net + API key as password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="upLoader <noreply@uploader.app>"

# --- Frontend URL (for password reset links & OAuth redirects) ---
FRONTEND_URL=http://localhost:5173
