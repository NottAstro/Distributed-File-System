# Frontend build-time settings (copy to .env.local for local overrides)

# Public URL of the backend API, including /api.
# Production example: https://api.your-domain.com/api
# Leave unset locally to use the Vite dev proxy (/api -> http://localhost:3000).
VITE_API_URL=

# Optional fallback only. The Google client ID is normally served by the
# backend (GOOGLE_CLIENT_ID via /api/auth/config), so it can't drift.
VITE_GOOGLE_CLIENT_ID=
